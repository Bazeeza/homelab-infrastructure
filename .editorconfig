root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{yml,yaml,json,jsonc,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads a file without BOM as the ANSI code page
[*.{ps1,psd1}]
charset = utf-8-bom
end_of_line = crlf
