# /etc/systemd/system/n8n-backup.timer on node-b
#
# The servers keep their clock in UTC. The time zone at the end of OnCalendar=
# makes the backup follow local time, including daylight saving changes.
#
#   systemctl enable --now n8n-backup.timer
#   systemctl list-timers n8n-backup.timer      # next and last run

[Unit]
Description=Run the n8n backup every day at 04:00 local time

[Timer]
OnCalendar=*-*-* 04:00:00 America/Toronto
# If the node was off at 04:00, run the missed backup as soon as it is back
Persistent=true
# Spread the start a little so it never lines up exactly with other jobs
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
